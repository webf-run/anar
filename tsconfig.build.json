{
  "extends": "./config/tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "outDir": "./dist",
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "include": [
    "./src/augment.d.ts",
    "./src/Anar.tsx",
    "./src/Button/**/*",
    "./src/Collection/**/*",
    "./src/Input/**/*",
    "./src/Util/**/*"
  ],
  "exclude": [
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.story.tsx",
    "**/*.play.tsx",
    "**/*.stories.tsx"
  ]
}
